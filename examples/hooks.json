{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/wiki-session-start.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./hooks/wiki-session-end.sh",
        "timeout": 3
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/wiki-session-end.sh",
        "timeout": 3
      }
    ]
  }
}
