#!/usr/bin/env bash
# >>> wiki-doc-deps hook >>> (managed by ~/.cursor/llm-wiki/scripts/install-repo-hooks.sh)
DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$DIR/_wiki-doc-deps-common.sh"
# $1 is the is-squash flag; ORIG_HEAD points at the pre-merge commit.
if git rev-parse --verify -q ORIG_HEAD >/dev/null 2>&1; then
  wiki_deps_report ORIG_HEAD HEAD
fi
wiki_deps_run_local_chain "$DIR/post-merge.local" "$@"
# <<< wiki-doc-deps hook <<<
